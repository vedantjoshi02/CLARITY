DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=127.0.0.1,localhost

# disabled shows approved excerpts. gemini enables generated answers.
LLM_PROVIDER=disabled
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
AI_MAX_OUTPUT_TOKENS=1800

# Optional. Text search works without an embedding API.
AI_SEMANTIC_RETRIEVAL=false
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
AI_RETRIEVAL_TOP_K=6
AI_SIMILARITY_THRESHOLD=0.45

# Optional institutional signup policy. Use administrator approval to verify the selected year.
STUDENT_APPROVAL_REQUIRED=false
STUDENT_EMAIL_DOMAINS=

# Development uses the console email backend unless configured otherwise.
# In production set PUBLIC_BASE_URL to the trusted HTTPS URL and configure SMTP.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
PUBLIC_BASE_URL=
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=CLARITY <no-reply@localhost>

# Install Tesseract and the corresponding language data for automatic PDF OCR.
OCR_ENABLED=true
TESSERACT_COMMAND=tesseract
OCR_LANGUAGES=eng
